# Copy to backend/.env and adjust as needed. Never commit backend/.env.
#
# Matches the credentials in docker-compose.yml. The hostname is `db` when
# running inside Compose and `localhost` when running the app on the host
# against the Compose-published port.

POSTGRES_USER=podclub
POSTGRES_PASSWORD=podclub
POSTGRES_DB=podclub

# Host-side URL (app running on your machine, Postgres in Compose).
DATABASE_URL=postgresql+psycopg://podclub:podclub@localhost:5432/podclub

# In-Compose URL (uncomment when the app itself runs as a Compose service).
# DATABASE_URL=postgresql+psycopg://podclub:podclub@db:5432/podclub

# Echo every SQL statement to stdout. Useful while developing migrations.
SQL_ECHO=false
