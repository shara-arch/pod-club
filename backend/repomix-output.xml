    data JSONB NOT NULL
);

CREATE TABLE IF NOT EXISTS music (
    id TEXT PRIMARY KEY,
    data JSONB NOT NULL
);

CREATE TABLE IF NOT EXISTS playlists (
    id TEXT PRIMARY KEY,
    data JSONB NOT NULL
);

